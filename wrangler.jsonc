{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "origamio",
  "compatibility_date": "2026-10-01",
  // A static site: the built files are served as Worker assets, no script needed.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
}
