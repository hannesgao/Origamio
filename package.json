{
  "name": "origamio",
  "version": "0.1.0",
  "description": "Yet another origami simulator: fold a square sheet along arbitrary lines in the browser.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Hannes Gao",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "presets:write": "WRITE_PRESETS=1 vitest run tests/presets-json.test.ts",
    "shot": "node scripts/screenshot.mjs",
    "shot:ci": "node scripts/screenshot.mjs --browser linux --url http://localhost:4173/ --out shots/ci --scenario scripts/scenarios/baseline.mjs --width 1400 --height 900",
    "shot:compare": "node scripts/compare-shots.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "@types/three": "^0.186.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "pixelmatch": "^7.2.0",
    "playwright-core": "^1.63.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  },
  "dependencies": {
    "three": "^0.186.1"
  }
}
