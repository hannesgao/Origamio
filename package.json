{
  "name": "origamio",
  "version": "0.1.0",
  "description": "Yet another origami simulator: fold a square sheet along arbitrary lines in the browser.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Hannes Gao",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
